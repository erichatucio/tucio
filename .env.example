# Copy to .env for local development; configure equivalent variables in Render.

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development
APP_URL=http://localhost/

# Database Configuration
DB_DRIVER=mysql
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4
DB_PREFIX=
# Local .env: set DB_SSL_CA to Aiven's CA certificate file path.
# Render: set DB_SSL_CA_CERT to the full PEM certificate contents.
DB_SSL_CA=
DB_SSL_CA_CERT=
JWT_SECRET=
REFRESH_TOKEN_KEY=
FRONTEND_ORIGIN=http://localhost:5173

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
